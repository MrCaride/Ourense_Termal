rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      match /redeemed_rewards/{rewardId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }
    }

    match /check_ins/{checkInId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /badges/{badgeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /user_route_progress/{progressId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Catálogos de lectura pública.
    match /thermal_points/{pointId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /routes/{routeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
