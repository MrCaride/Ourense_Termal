rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isThermalManagerOfPoint(pointId) {
      return isSignedIn() &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'thermalManager' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'thermal_manager' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'
        ) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.thermalPointId == pointId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;

      match /redeemed_rewards/{rewardId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }
    }

    match /manager_point_requests/{managerId} {
      allow read: if isOwner(managerId) || isAdmin();
      allow create, update: if isOwner(managerId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /check_ins/{checkInId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /badges/{badgeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /user_route_progress/{progressId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Catálogos de lectura pública.
    match /thermal_points/{pointId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /activeQR/{qrId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin() || isThermalManagerOfPoint(pointId);
      }
    }

    // Compatibilidad con estructura legacy.
    match /thermalPoints/{pointId} {
      allow read: if true;

      match /activeQR/{qrId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin() || isThermalManagerOfPoint(pointId);
      }
    }

    // Necesario para consultas collectionGroup('activeQR') del historial admin.
    match /{path=**}/activeQR/{qrId} {
      allow read: if isSignedIn();
    }

    match /routes/{routeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
